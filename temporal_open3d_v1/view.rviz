Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 27; 30; 36
    Fixed Frame: uchile_processed
    Frame Rate: 24
  Displays:
    - Class: rviz/PointCloud2
      Name: raw
      Enabled: true
      Value: true
      Topic: /mining_temporal_review/raw
      Position Transformer: XYZ
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 3
      Queue Size: 1
      Decay Time: 0
